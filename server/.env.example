GEMINI_API_KEY=your_key_here
PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
GEMINI_MODEL=gemini-3-flash-preview
GCS_BUCKET_NAME=la28-momentum-cache
GCS_FILE_NAME=momentum-data.json
# Local Firestore development only. Cloud Run uses Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json
# Keep disabled while the local machine is the only cache writer.
ENABLE_CRON_ORCHESTRATION=false
